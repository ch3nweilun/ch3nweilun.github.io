---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactLinks, cvGroups, profile, projects, publications } from '../data/site';
---

<BaseLayout title={`${profile.name} | Resume`} description={profile.summary}>
  <article class="resume-sheet">
    <header class="resume-header">
      <aside class="contact-card" aria-label="Contact information">
        <img src="/profile.jpg" alt={`${profile.name} portrait`} loading="eager" />
        <div>
          <p>{profile.affiliation}</p>
          <p>{profile.location}</p>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
        <div class="contact-links">
          {contactLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </aside>
      <div class="intro-card">
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="summary">{profile.summary}</p>
      </div>
    </header>

    <div class="resume-body">
      <aside class="secondary-column">
        {cvGroups.map((group) => (
          <section class="resume-section compact">
            <div class="section-heading">
              <h2>{group.title}</h2>
            </div>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))}
      </aside>

      <main class="primary-column">
        <section class="resume-section">
          <div class="section-heading">
            <span>01</span>
            <h2>Profile</h2>
          </div>
          <p>
            Computer science student at UCAS with interests across artificial intelligence, data mining,
            recommender systems, and large language models. This page is structured as a concise resume view
            so education, skills, projects, and research output can be scanned together.
          </p>
        </section>

        <section class="resume-section">
          <div class="section-heading">
            <span>02</span>
            <h2>Projects</h2>
          </div>
          {projects.length > 0 ? (
            <div class="entry-list">
              {projects.map((project) => (
                <article class="entry">
                  <div class="entry-topline">
                    <h3>{project.title}</h3>
                    <span>{project.status}</span>
                  </div>
                  <p>{project.description}</p>
                  <div class="tag-row">
                    {project.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                  <div class="link-row">
                    {Object.entries(project.links).map(([label, href]) => <a href={href}>{label}</a>)}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="muted">
              Project entries can be added here with role, technology stack, links, and measurable outcomes.
            </p>
          )}
        </section>

        <section class="resume-section">
          <div class="section-heading">
            <span>03</span>
            <h2>Research Output</h2>
          </div>
          {publications.length > 0 ? (
            <div class="entry-list">
              {publications.map((paper) => (
                <article class="entry">
                  <div class="entry-topline">
                    <h3>{paper.title}</h3>
                    <span>{paper.year} · {paper.venue}</span>
                  </div>
                  <p class="authors">{paper.authors}</p>
                  <p>{paper.abstract}</p>
                  <div class="tag-row">
                    {paper.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                  <div class="link-row">
                    {Object.entries(paper.links).map(([label, href]) => <a href={href}>{label}</a>)}
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="muted">
              Publications, preprints, technical reports, or selected research notes can be listed here when ready.
            </p>
          )}
        </section>
      </main>
    </div>
  </article>
</BaseLayout>

<style>
  .resume-sheet {
    --resume-columns: minmax(250px, 0.36fr) minmax(0, 1fr);
    margin: clamp(1.5rem, 4vw, 3rem) auto clamp(3rem, 7vw, 5rem);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.1);
    overflow: hidden;
  }

  .resume-header {
    display: grid;
    grid-template-columns: var(--resume-columns);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 5vw, 3.25rem);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(135deg, #ffffff 0%, #f4f8fb 100%);
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.45;
  }

  .role {
    max-width: 780px;
    margin: 1rem 0 0;
    color: var(--text);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 400;
    line-height: 1.45;
  }

  .summary,
  .resume-section p,
  .resume-section li,
  .contact-card p {
    color: var(--muted);
    line-height: 1.7;
  }

  .summary {
    max-width: 720px;
    margin: 1rem 0 0;
    font-size: 1rem;
  }

  .contact-card {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .contact-card img {
    width: min(100%, 140px);
    height: auto;
    border-radius: 12px;
    object-fit: contain;
  }

  .contact-card p {
    margin: 0;
    font-size: 0.92rem;
  }

  .contact-card a {
    color: var(--accent);
    font-weight: 700;
  }

  .contact-links,
  .link-row,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-links a,
  .link-row a,
  .tag-row span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.65rem;
    background: #f8fafc;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .resume-body {
    display: grid;
    grid-template-columns: var(--resume-columns);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 5vw, 3.25rem);
  }

  .primary-column,
  .secondary-column,
  .entry-list {
    display: grid;
    gap: 1.35rem;
  }

  .secondary-column {
    align-content: start;
  }

  .resume-section {
    display: grid;
    gap: 0.75rem;
  }

  .resume-section.compact {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .section-heading span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 900;
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2 {
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    font-size: 1.12rem;
  }

  .entry {
    border-left: 2px solid var(--line);
    padding-left: 1rem;
  }

  .entry-topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .entry-topline span,
  .authors,
  .muted {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .tag-row,
  .link-row {
    margin-top: 0.65rem;
  }

  ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  @media (max-width: 860px) {
    .resume-header,
    .resume-body {
      grid-template-columns: 1fr;
    }

    .contact-card {
      padding: 0;
    }

    .entry-topline {
      display: grid;
      gap: 0.25rem;
    }
  }
</style>
