---
import NetworkBackground from '../components/NetworkBackground.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactLinks, cvGroups, profile, projects, publications } from '../data/site';
---

<BaseLayout>
  <NetworkBackground />

  <section class="hero section">
    <div class="hero-copy">
      <p class="section-kicker">AI / Data / Network Lab</p>
      <h1>{profile.role}</h1>
      <p class="hero-summary">{profile.summary}</p>
      <div class="hero-actions">
        <a class="primary-action" href="#publications">View Publications</a>
        <a class="secondary-action" href={`mailto:${profile.email}`}>Start Collaboration</a>
      </div>
    </div>
    <div class="research-orbit" aria-label="Research topic graph">
      <div class="orbit-core">LLM<br />RecSys</div>
      <span class="orbit-node node-1">User Behavior</span>
      <span class="orbit-node node-2">Sequential Rec</span>
      <span class="orbit-node node-3">Data Mining</span>
      <span class="orbit-node node-4">Evaluation</span>
    </div>
  </section>

  <section id="publications" class="section split-section">
    <div>
      <p class="section-kicker">Publications</p>
      <h2 class="section-title">Selected work ready for BibTeX, PDF, code, and arXiv links.</h2>
    </div>
    <div class="stack">
      {publications.length > 0 ? (
        publications.map((paper) => (
          <article class="card publication-card">
            <div class="paper-meta">
              <span>{paper.year}</span>
              <span>{paper.venue}</span>
            </div>
            <h3>{paper.title}</h3>
            <p class="authors">{paper.authors}</p>
            <p>{paper.abstract}</p>
            <div class="pill-row">
              {paper.tags.map((tag) => <span class="pill">{tag}</span>)}
            </div>
            <div class="link-row">
              {Object.entries(paper.links).map(([label, href]) => <a href={href}>{label.toUpperCase()}</a>)}
            </div>
          </article>
        ))
      ) : (
        <article class="card empty-card">
          <h3>Publications will be added soon.</h3>
          <p>This section is intentionally empty for now.</p>
        </article>
      )}
    </div>
  </section>

  <section id="projects" class="section">
    <p class="section-kicker">Projects</p>
    <h2 class="section-title">Research prototypes with room for systems, demos, and code.</h2>
    <div class="grid">
      {projects.length > 0 ? (
        projects.map((project) => (
          <article class="card project-card">
            <span class="status">{project.status}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="pill-row">
              {project.tags.map((tag) => <span class="pill">{tag}</span>)}
            </div>
            <div class="link-row">
              {Object.entries(project.links).map(([label, href]) => <a href={href}>{label}</a>)}
            </div>
          </article>
        ))
      ) : (
        <article class="card empty-card">
          <h3>Projects will be added soon.</h3>
          <p>This section is intentionally empty for now.</p>
        </article>
      )}
    </div>
  </section>

  <section id="cv" class="section split-section">
    <div>
      <p class="section-kicker">CV Snapshot</p>
      <h2 class="section-title">Academic profile without turning the homepage into a resume wall.</h2>
      <p class="section-copy">Keep this concise on the homepage. Link a full PDF CV after you add one to `public/`.</p>
    </div>
    <div class="stack">
      {cvGroups.map((group) => (
        <article class="card cv-card">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="section contact-panel">
    <p class="section-kicker">Contact</p>
    <h2>Open to research collaboration in recommendation, LLMs, and data mining.</h2>
    <p>{profile.affiliation} · {profile.location}</p>
    <div class="contact-links">
      {contactLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    align-items: center;
    min-height: calc(100vh - 86px);
    gap: clamp(2rem, 6vw, 6rem);
  }

  h1 {
    margin: 0;
    max-width: 880px;
    font-size: clamp(3.25rem, 8vw, 7.8rem);
    line-height: 0.86;
    letter-spacing: -0.08em;
    text-wrap: balance;
  }

  .hero-summary {
    max-width: 680px;
    color: var(--muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.75;
  }

  .hero-actions,
  .link-row,
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .primary-action,
  .secondary-action,
  .link-row a,
  .contact-links a {
    border: 1px solid rgba(120, 248, 255, 0.24);
    border-radius: 999px;
    padding: 0.75rem 1rem;
    background: rgba(33, 212, 253, 0.08);
    color: #d7fbff;
    font-weight: 700;
  }

  .primary-action {
    border-color: transparent;
    background: linear-gradient(135deg, var(--cyan), var(--mint));
    color: #03111a;
  }

  .research-orbit {
    position: relative;
    aspect-ratio: 1;
    border: 1px solid rgba(120, 248, 255, 0.18);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(33, 212, 253, 0.22), transparent 33%),
      linear-gradient(145deg, rgba(12, 26, 45, 0.72), rgba(5, 10, 18, 0.42));
    box-shadow: inset 0 0 80px rgba(33, 212, 253, 0.12), 0 32px 110px rgba(0, 0, 0, 0.42);
  }

  .research-orbit::before,
  .research-orbit::after {
    content: '';
    position: absolute;
    inset: 17%;
    border: 1px dashed rgba(138, 255, 193, 0.2);
    border-radius: 50%;
  }

  .research-orbit::after {
    inset: 32%;
    border-color: rgba(33, 212, 253, 0.24);
  }

  .orbit-core,
  .orbit-node {
    position: absolute;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .orbit-core {
    inset: 36%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cyan), var(--blue));
    color: white;
    font-weight: 900;
    box-shadow: 0 0 42px rgba(33, 212, 253, 0.5);
  }

  .orbit-node {
    border: 1px solid rgba(120, 248, 255, 0.24);
    border-radius: 999px;
    padding: 0.6rem 0.85rem;
    background: rgba(5, 10, 18, 0.82);
    color: #d8fcff;
    font-size: 0.85rem;
    box-shadow: 0 0 24px rgba(33, 212, 253, 0.18);
  }

  .node-1 { left: 3%; top: 27%; }
  .node-2 { right: 2%; top: 22%; }
  .node-3 { left: 16%; bottom: 11%; }
  .node-4 { right: 12%; bottom: 16%; }

  .research-grid,
  .grid {
    margin-top: 2rem;
  }

  .research-card p:first-child,
  .status,
  time,
  .paper-meta {
    color: var(--mint);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card h3 {
    margin: 0.55rem 0;
    font-size: 1.35rem;
  }

  .card p,
  .card li {
    color: var(--muted);
    line-height: 1.7;
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
  }

  .stack {
    display: grid;
    gap: 1rem;
  }

  .paper-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .authors {
    color: #d4e9ff !important;
  }

  ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .contact-panel {
    margin-bottom: 5rem;
    border: 1px solid rgba(120, 248, 255, 0.2);
    border-radius: 36px;
    padding: clamp(2rem, 6vw, 4rem);
    background: linear-gradient(135deg, rgba(33, 212, 253, 0.12), rgba(138, 255, 193, 0.08));
    box-shadow: var(--shadow);
  }

  .contact-panel h2 {
    max-width: 880px;
    margin: 0;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .contact-panel p {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero,
    .split-section {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .research-orbit {
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
    }
  }
</style>
