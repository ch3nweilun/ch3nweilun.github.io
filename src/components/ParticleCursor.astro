<canvas class="particle-cursor" aria-hidden="true"></canvas>

<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMotion.matches) return;

    const canvas = document.querySelector('.particle-cursor');
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const colors = ['33, 212, 253', '138, 255, 193', '78, 94, 255'];
    const particles = [];
    const maxParticles = 110;
    let width = 0;
    let height = 0;
    let lastX = window.innerWidth / 2;
    let lastY = window.innerHeight / 2;
    let lastSpawn = 0;
    let rafId = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const addParticle = (x, y, speed = 1) => {
      const count = Math.min(5, Math.max(2, Math.round(speed / 12)));
      for (let i = 0; i < count; i += 1) {
        const angle = Math.random() * Math.PI * 2;
        const drift = 0.35 + Math.random() * 1.55;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * drift + (Math.random() - 0.5) * speed * 0.018,
          vy: Math.sin(angle) * drift + (Math.random() - 0.5) * speed * 0.018,
          radius: 1.2 + Math.random() * 3.2,
          life: 1,
          decay: 0.012 + Math.random() * 0.018,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }
      if (particles.length > maxParticles) {
        particles.splice(0, particles.length - maxParticles);
      }
    };

    const handlePointerMove = (event) => {
      const now = performance.now();
      if (now - lastSpawn < 18) return;
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      const speed = Math.hypot(dx, dy);
      lastX = event.clientX;
      lastY = event.clientY;
      lastSpawn = now;
      addParticle(event.clientX, event.clientY, speed);
    };

    const handleTouchMove = (event) => {
      const touch = event.touches[0];
      if (!touch) return;
      addParticle(touch.clientX, touch.clientY, 18);
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      ctx.globalCompositeOperation = 'lighter';

      for (let i = particles.length - 1; i >= 0; i -= 1) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.985;
        p.vy *= 0.985;
        p.life -= p.decay;

        if (p.life <= 0) {
          particles.splice(i, 1);
          continue;
        }

        const alpha = Math.max(0, p.life);
        const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius * 7);
        glow.addColorStop(0, `rgba(${p.color}, ${0.42 * alpha})`);
        glow.addColorStop(0.38, `rgba(${p.color}, ${0.18 * alpha})`);
        glow.addColorStop(1, `rgba(${p.color}, 0)`);
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius * 7, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = `rgba(230, 255, 255, ${0.72 * alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      }

      rafId = window.requestAnimationFrame(draw);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pointermove', handlePointerMove, { passive: true });
    window.addEventListener('touchmove', handleTouchMove, { passive: true });
    rafId = window.requestAnimationFrame(draw);

    reduceMotion.addEventListener('change', (event) => {
      if (event.matches) {
        window.cancelAnimationFrame(rafId);
        ctx.clearRect(0, 0, width, height);
        particles.length = 0;
      } else {
        rafId = window.requestAnimationFrame(draw);
      }
    });
  })();
</script>

<style>
  .particle-cursor {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.9;
    mix-blend-mode: screen;
  }

  @media (prefers-reduced-motion: reduce) {
    .particle-cursor {
      display: none;
    }
  }
</style>
