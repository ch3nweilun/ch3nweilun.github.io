---
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | AI & Data Research`,
  description = profile.summary,
} = Astro.props;

const navItems = [
  { label: 'Research', href: '/#research' },
  { label: 'Publications', href: '/#publications' },
  { label: 'Projects', href: '/#projects' },
  { label: 'CV', href: '/#cv' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Homepage">
        <span class="brand-mark"></span>
        <span>{profile.name}</span>
      </a>
      <nav aria-label="Primary navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>{profile.name}</span>
      <span>{profile.role}</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #050a12;
    --panel: rgba(9, 20, 35, 0.74);
    --panel-strong: rgba(14, 29, 49, 0.92);
    --text: #edf7ff;
    --muted: #9fb2c8;
    --cyan: #21d4fd;
    --mint: #8affc1;
    --blue: #4e5eff;
    --line: rgba(161, 234, 255, 0.18);
    --shadow: 0 22px 80px rgba(0, 0, 0, 0.38);
    font-family: Sora, Avenir Next, Montserrat, Trebuchet MS, sans-serif;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background: transparent;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(5, 10, 18, 0.15), rgba(5, 10, 18, 0.94) 62%, #050a12 100%);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 4vw, 4rem);
    border-bottom: 1px solid rgba(161, 234, 255, 0.12);
    background: rgba(5, 10, 18, 0.72);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .brand-mark {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    background: var(--mint);
    box-shadow: 0 0 24px var(--cyan), 0 0 42px rgba(138, 255, 193, 0.45);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  nav a {
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.55rem 0.8rem;
    color: var(--muted);
    font-size: 0.9rem;
    transition: 180ms ease;
  }

  nav a:hover {
    border-color: rgba(120, 248, 255, 0.28);
    color: var(--text);
    background: rgba(120, 248, 255, 0.08);
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .section {
    padding: clamp(3.5rem, 8vw, 7rem) 0;
  }

  .section-kicker {
    margin: 0 0 0.75rem;
    color: var(--mint);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-title {
    margin: 0 0 1rem;
    max-width: 760px;
    font-size: clamp(2rem, 5vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .section-copy {
    max-width: 740px;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.8;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 1.35rem;
    background: linear-gradient(145deg, rgba(12, 26, 45, 0.82), rgba(9, 16, 29, 0.64));
    box-shadow: var(--shadow);
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pill {
    border: 1px solid rgba(120, 248, 255, 0.22);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    color: #c9faff;
    background: rgba(33, 212, 253, 0.08);
    font-size: 0.78rem;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem clamp(1rem, 4vw, 4rem);
    border-top: 1px solid rgba(161, 234, 255, 0.12);
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .site-header,
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
